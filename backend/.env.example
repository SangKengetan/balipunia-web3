# ============================================================
# BACKEND — ENVIRONMENT VARIABLES
# Salin file ini menjadi .env lalu isi nilainya
# ============================================================

# ============================================================
# SERVER
# ============================================================

# Port yang digunakan Express server
PORT=5000

# ============================================================
# DATABASE — PostgreSQL
# ============================================================

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Pastikan database sudah dibuat sebelumnya: CREATE DATABASE balipunia;
DATABASE_URL=postgresql://postgres:password@localhost:5432/balipunia

# ============================================================
# AUTENTIKASI — JWT
# ============================================================

# Secret key untuk signing dan verifikasi JWT token admin
# Gunakan string acak yang panjang dan kompleks
JWT_SECRET=your_super_secret_jwt_key_ganti_ini

# ============================================================
# GOOGLE OAUTH
# ============================================================

# Client ID Google untuk memverifikasi token login donor via Google
# Dapatkan dari: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================================
# IPFS — PINATA
# ============================================================

# Credentials dari dashboard Pinata: https://app.pinata.cloud/keys
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# JWT Pinata (disarankan menggunakan ini untuk autentikasi modern)
PINATA_JWT=your_pinata_jwt_token

# Subdomain dedicated gateway IPFS milik akun Pinata kamu
# Format: subdomain.mypinata.cloud (tanpa https://)
PINATA_GATEAWAY=your_subdomain.mypinata.cloud

# ============================================================
# PAYMENT GATEWAY — MIDTRANS
# ============================================================

# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
# Gunakan Sandbox keys untuk development, Production keys untuk live
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx

# ============================================================
# BLOCKCHAIN — BSC TESTNET
# ============================================================

# RPC URL untuk terhubung ke BSC Testnet (Chain ID: 97)
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# --- Alamat Smart Contract (isi setelah deploy) ---
# Alamat kontrak DonationVaultV5 yang sudah ter-deploy
DONATION_VAULT_ADDRESS=0xYourDonationVaultV5Address

# Alamat kontrak FinancialReportAnchor yang sudah ter-deploy
FINANCIAL_REPORT_ANCHOR_ADDRESS=0xYourFinancialReportAnchorAddress

# Alamat kontrak VotingGovernance (VotingV3) yang sudah ter-deploy
VOTING_CONTRACT_ADDRESS=0xYourVotingGovernanceAddress

# --- Alamat Token Stablecoin (BSC Testnet) ---
# Ini adalah alamat token USDT/USDC di BSC Testnet (tidak perlu diubah)
USDT_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
USDC_ADDRESS=0x64544969ed7EBf5f083679233325356EbE738930

# --- Private Keys (untuk signing transaksi dari server) ---
# ⚠️ WAJIB RAHASIA: Jangan pernah commit nilai ini ke Git!
# Private key akun Super Admin (pemilik kontrak)
OWNER_PRIVATE_KEY=0xYourSuperAdminPrivateKeyHere
SUPER_ADMIN_PRIVATE_KEY=0xYourSuperAdminPrivateKeyHere

# Private key Trustee (opsional, hanya jika backend perlu sign atas nama trustee)
TRUSTEE_PRIVATE_KEY=0xYourTrusteePrivateKeyHere
