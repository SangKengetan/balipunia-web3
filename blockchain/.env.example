# ============================================================
# BLOCKCHAIN — ENVIRONMENT VARIABLES
# Salin file ini menjadi .env lalu isi nilainya
# Digunakan oleh Hardhat untuk deploy dan interaksi kontrak
# ============================================================

# ============================================================
# DEPLOY KEYS
# ============================================================

# Private key akun utama untuk deploy kontrak (Super Admin / Owner)
# ⚠️ Pastikan akun ini memiliki BNB di BSC Testnet
# Faucet: https://testnet.bnbchain.org/faucet-smart
DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKeyHere

# Alias untuk DEPLOYER_PRIVATE_KEY (dipakai hardhat.config.js)
SUPERADMIN_PRIVATE_KEY=0xYourSuperAdminPrivateKeyHere

# Private key tambahan (opsional, untuk testing akun Admin Pura)
PRIVATE_KEY=0xYourAdminPuraPrivateKeyHere

# Private key tambahan (opsional, untuk testing akun Trustee)
PRIVATE_KEY2=0xYourTrusteePrivateKeyHere

# ============================================================
# NETWORK — BSC TESTNET (Chain ID: 97)
# ============================================================

BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# ============================================================
# TOKEN ADDRESSES — BSC TESTNET
# ============================================================

# Alamat token USDT (BEP-20) di BSC Testnet
USDT_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd

# Alamat token USDC (BEP-20) di BSC Testnet
USDC_ADDRESS=0x64544969ed7EBf5f083679233325356EbE738930

# ============================================================
# TRUSTEE ADDRESSES
# ============================================================

# Wallet address 3 Trustee yang akan didaftarkan ke VotingGovernance
# Trustee bertugas mengawasi dan memberi suara pada proposal withdraw
TRUSTEE_1=0xTrustee1WalletAddress
TRUSTEE_2=0xTrustee2WalletAddress
TRUSTEE_3=0xTrustee3WalletAddress

# ============================================================
# CONTRACT ADDRESSES (diisi setelah deploy berhasil)
# ============================================================

# Alamat DonationVaultV5 setelah di-deploy
DONATION_VAULT_ADDRESS=0xYourDonationVaultAddress

# Alamat VotingGovernance (VotingV3) setelah di-deploy
GOVERNANCE_ADDRESS=0xYourVotingGovernanceAddress
